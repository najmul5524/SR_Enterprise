# Google Firebase Cloud Firestore (For persistent cloud backup & auto-restore across Render deploys)
# Option A: Paste full raw JSON string from serviceAccountKey.json
FIREBASE_CREDENTIALS=
# Option B (Recommended for Render): Base64 encoded string of serviceAccountKey.json
FIREBASE_CREDENTIALS_BASE64=
# Option C: Relative or absolute path to serviceAccountKey.json file
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
